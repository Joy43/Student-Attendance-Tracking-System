# ==========================================
# Database Configuration
# ==========================================

# Use 'db' when running inside Docker locally. 
# For Render or cloud deployment, change this to your remote database host (e.g., Aiven).
DB_HOST=db

# Default local user is 'root'
DB_USER=root

# Default local password
DB_PASSWORD=attapp_password

# Default local database name
DB_NAME=attapp_db

# Default internal Docker port is 3306 (locally mapped to 3307 on your machine)
DB_PORT=3306
